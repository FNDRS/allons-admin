# Public - used by the browser client (anon key).
# Only the admin's own login session; this app reads no data with it.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Comma-separated allowlist of root admins (lowercase emails).
# Anyone not on this list will be signed out on access.
ROOT_ADMIN_EMAILS=marlon.castro@allonsapp.com

# Optional base URL used for QR links generated in /waitlist-qr.
# Example: https://allonsapp.com/
NEXT_PUBLIC_WAITLIST_BASE_URL=https://allonsapp.com/

# Server-only - base URL of allons-api (no trailing slash).
# Local: API on :3000, admin on :3002 (`pnpm dev`). Do NOT point this at the admin app.
# Every read and every write in this panel goes through it.
ADMIN_API_BASE_URL=http://localhost:3000

# Server-only - must match `ADMIN_API_SECRET` in allons-api.
# Sent as `x-admin-secret` header on every admin request.
ADMIN_API_SECRET=

# Optional - error reporting. Unset means Sentry stays off, same as in allons-api.
# These three are NEXT_PUBLIC_ because the browser needs them too, and Next
# bakes them at build time: set them as build args, not only at runtime.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=development
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1

# Build-only - uploading source maps. Without them Sentry shows minified
# stack traces; the build works either way.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
