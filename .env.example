# Public — used by the browser client (anon key).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — never expose to the client. Used by route handlers / server
# components for admin operations (auth.admin.listUsers, etc.).
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated allowlist of root admins (lowercase emails).
# Anyone not on this list will be signed out on access.
ROOT_ADMIN_EMAILS=marlon.castro@allonsapp.com

# Optional base URL used for QR links generated in /waitlist-qr.
# Example: https://allonsapp.com/
NEXT_PUBLIC_WAITLIST_BASE_URL=https://allonsapp.com/

# Server-only — admin endpoint of allons-api (no trailing slash).
# Used by Server Components directly and by /api/admin/payments/* proxies for
# client-side requests (ADMIN_API_SECRET is never sent to the browser).
ADMIN_API_BASE_URL=https://api.allonsapp.com

# Server-only — must match `ADMIN_API_SECRET` in allons-api.
# Sent as `x-admin-secret` header on every admin request.
ADMIN_API_SECRET=

# Redirect URL passed to Supabase inviteUserByEmail (feeds {{ .ConfirmationURL }}
# in dashboard preview). Use the HTTPS landing page — NOT allons:// (blocked in email).
# Local Expo web: http://localhost:8081/verify
APP_INVITE_REDIRECT_URL=https://allonsapp.com/verify

# Resend — invitaciones de comercio (lib/admin/comercioInviteMail.ts).
# RESEND_API_KEY y MAIL_FROM deben ser de la MISMA cuenta de Resend.
# Lista dominios verificados: curl -H "Authorization: Bearer $RESEND_API_KEY" https://api.resend.com/domains
RESEND_API_KEY=
# Remitente: dominio verificado en esa cuenta (hoy: thefndrs.com; luego no-reply@allonsapp.com).
MAIL_FROM=Allons <no-reply@thefndrs.com>
